#!/usr/bin/env bash
# Real-time progress/todo workbench for Guix-sheng.
# Aggregates "- [ ]"/"- [x]" items from TODO.md and collab/rooms/*.md
# into collab/workbench/STATUS.md.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$ROOT/collab/workbench/STATUS.md"
WATCH=0; INTERVAL=5
while [[ $# -gt 0 ]]; do
  case "$1" in
    --watch) WATCH=1; shift;;
    --interval) INTERVAL="$2"; shift 2;;
    *) echo "unknown arg: $1" >&2; exit 2;;
  esac
done
render() {
  local ts; ts="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  local pending done count_p count_d
  pending="$(grep -rhoE -- '- \[ \].*' "$ROOT/TODO.md" "$ROOT"/collab/rooms/*.md 2>/dev/null | grep -v 'workbench aggregates' || true)"
  done="$(grep -rhoE -- '- \[[xX]\].*' "$ROOT/TODO.md" "$ROOT"/collab/rooms/*.md 2>/dev/null | grep -v 'workbench aggregates' || true)"
  count_p="$(printf '%s\n' "$pending" | grep -c . 2>/dev/null || echo 0)"
  count_d="$(printf '%s\n' "$done" | grep -c . 2>/dev/null || echo 0)"
  {
    echo "# Workbench STATUS"; echo
    echo "Generated: $ts (UTC)"; echo
    echo "## Summary"; echo
    echo "- Pending: $count_p"; echo "- Done: $count_d"; echo
    echo "## Pending"; echo
    if [[ -n "$pending" ]]; then printf '%s\n' "$pending"; else echo "(none)"; fi
    echo; echo "## Done"; echo
    if [[ -n "$done" ]]; then printf '%s\n' "$done"; else echo "(none)"; fi
    echo; echo "## Rooms"; echo
    for f in "$ROOT"/collab/rooms/*.md; do echo "- $(basename "$f")"; done
  } > "$OUT"
  echo "[$ts] pending=$count_p done=$count_d -> $OUT"
}
if [[ $WATCH -eq 1 ]]; then while true; do render; sleep "$INTERVAL"; done; else render; fi
