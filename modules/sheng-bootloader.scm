;; modules/sheng-bootloader.scm — U-Boot/extlinux boot chain for sheng.
;;
;; The board's U-Boot runs:
;;   sysboot scsi 0:${partnum} any ${pxefile_addr_r} /boot/extlinux/extlinux.conf
;; so all this module has to do is write that file.  Guix's stock
;; extlinux-bootloader cannot be used: its installer runs the x86 syslinux
;; binary, which does not exist for aarch64, and its generator only offers
;; FDTDIR, while this board needs one exact device tree.
(define-module (modules sheng-bootloader)
  #:use-module (gnu bootloader)
  #:use-module (guix gexp)
  #:use-module (guix licenses)
  #:use-module (guix packages)
  #:use-module (guix build-system trivial)
  #:use-module (srfi srfi-1)
  #:export (sheng-extlinux-bootloader
            sheng-dtb-path))

(define sheng-dtb-path
  "lib/dtbs/qcom/sm8550-xiaomi-sheng.dtb")

(define sheng-extlinux-package
  (package
    (name "sheng-extlinux")
    (version "0")
    (source #f)
    (build-system trivial-build-system)
    (arguments
     (list #:builder
           #~(begin
               (use-modules (guix build utils))
               (mkdir-p #$output))))
    (synopsis "extlinux configuration for sheng")
    (description
     "Empty package used as the bootloader field of the sheng extlinux
bootloader record.  The actual configuration file is generated by Guix.")
    (home-page "https://github.com/Murkiness4095/nixos-sheng")
    (license gpl2+)))

(define* (sheng-extlinux-configuration-file config entries
                                            #:key
                                            (system (%current-system))
                                            (old-entries '())
                                            #:allow-other-keys)
  "Return an extlinux.conf for CONFIG and ENTRIES that U-Boot's sysboot can
load from /boot/extlinux/extlinux.conf.  Kernel and initrd are absolute store
paths on the root partition, which U-Boot reads through ext4load."
  (define all-entries
    (append entries (bootloader-configuration-menu-entries config)))

  (define default-index
    (let ((index (bootloader-configuration-default-entry config)))
      (if (< index (length all-entries)) index 0)))

  ;; Guix's menu-entry labels contain spaces ("GNU with Linux-Libre ..."),
  ;; but extlinux parses LABEL as a single token.  Use our own labels and
  ;; point DEFAULT at the default entry's label.
  (define (label-for index)
    (if (= index default-index)
        "guix-default"
        (format #f "guix-gen-~a" index)))

  (define (entry->gexp index entry)
    (let ((kernel (menu-entry-linux entry))
          (arguments (menu-entry-linux-arguments entry))
          (initrd (menu-entry-initrd entry)))
      #~(begin
          (format port "~%LABEL ~a~%" #$(label-for index))
          (format port "  LINUX ~a~%  FDT ~a/~a~%"
                  #$kernel (dirname #$kernel) #$sheng-dtb-path)
          #$@(if initrd
                 (list #~(format port "  INITRD ~a~%" #$initrd))
                 '())
          (format port "  APPEND ~a~%"
                  (string-join (list #$@arguments) " ")))))

  (define builder
    #~(call-with-output-file #$output
        (lambda (port)
          (format port "# Generated by Guix for sheng.  Do not edit.~%DEFAULT ~a~%PROMPT 0~%TIMEOUT ~a~%"
                  #$(label-for default-index)
                  (* 10 #$(bootloader-configuration-timeout config)))
          #$@(map entry->gexp
                  (iota (length all-entries))
                  all-entries)
          #$@(if (pair? old-entries)
                 (list #~(format port "~%")
                       #$@(map entry->gexp
                               (iota (length old-entries)
                                     (length all-entries))
                               old-entries))
                 '()))))

  (computed-file "extlinux.conf" builder
                 #:options '(#:local-build? #t
                             #:substitutable? #f)))

(define sheng-extlinux-bootloader
  (bootloader
   (name 'sheng-extlinux)
   (package sheng-extlinux-package)
   ;; Nothing to install: U-Boot itself lives in boot_a/boot_b, and the
   ;; configuration file is copied by 'install-boot-config'.  The image
   ;; builder calls installers with DEVICE = #f.
   (installer #~(lambda (bootloader device mount-point) #t))
   (configuration-file "/boot/extlinux/extlinux.conf")
   (configuration-file-generator sheng-extlinux-configuration-file)))
